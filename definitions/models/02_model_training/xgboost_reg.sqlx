config {
  type: 'operations',
  hasOutput: true,
  schema: 'df_bqml_chicago_taxi_trips'
}

CREATE OR REPLACE MODEL ${self()}
OPTIONS (
  MODEL_TYPE = 'BOOSTED_TREE_REGRESSOR',
  BOOSTER_TYPE = 'GBTREE',
  TREE_METHOD = 'AUTO',
  INPUT_LABEL_COLS = ['label']
)
AS
  SELECT
    *
  FROM
    ${ref('chicago_taxi_trips_training')}